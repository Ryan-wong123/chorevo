rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /danceVideos/{userId}/{fileName} {
      allow read: if true;

      allow write: if isOwner(userId)
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    match /danceThumbnails/{userId}/{fileName} {
      allow read: if true;

      allow write: if isOwner(userId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Group-only videos and their thumbnails. Only the uploader writes; any
    // signed-in user may read (the URLs are only stored in group posts,
    // which Firestore rules limit to the group's readers).
    match /groupVideos/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId)
        && (request.resource == null
          || (request.resource.size < 200 * 1024 * 1024
            && request.resource.contentType.matches('video/.*')));
    }

    match /groupThumbnails/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId)
        && (request.resource == null
          || (request.resource.size < 10 * 1024 * 1024
            && request.resource.contentType.matches('image/.*')));
    }

    match /profilePhotos/{userId}/{fileName} {
      allow read: if isSignedIn();

      allow write: if isOwner(userId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Generated pose templates, scoped to the uploader.
    match /danceTemplates/{userId}/{fileName} {
      allow read: if isSignedIn();

      allow create, update: if isOwner(userId)
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType == 'application/json';

      allow delete: if isOwner(userId);
    }

    // Templates written before uploader scoping: readable, no longer writable.
    match /danceTemplates/{fileName} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

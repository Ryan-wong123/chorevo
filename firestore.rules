rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ── Shared validation ─────────────────────────────────────────────────
    // Client timestamps (epoch ms) must be close to the server's clock, so
    // nobody can pin content to the top or bottom of a list by forging dates.
    function isRecent(t, windowMs) {
      return t is int
        && t > request.time.toMillis() - windowMs
        && t < request.time.toMillis() + windowMs;
    }

    function hourMs() {
      return 60 * 60 * 1000;
    }

    function isShortText(v, max) {
      return v is string && v.size() <= max;
    }

    // Display name copied onto posts, members, comments, etc.
    function isName(v) {
      return v is string && v.size() > 0 && v.size() <= 60;
    }

    // Optional https URL (profile photos come from Firebase Storage or Google).
    function isOptionalHttpsUrl(v) {
      return v == null || (v is string && v.size() <= 2048 && v.matches('https://.+'));
    }

    // A download URL of a file in this project's Storage, in `folder/uid/`.
    function isStorageUrl(v, folder, uid) {
      return v is string
        && v.size() <= 2048
        && v.matches('https://firebasestorage[.]googleapis[.]com/v0/b/[^/]+/o/' + folder + '%2F' + uid + '%2F[^/]+');
    }

    function hasValidAnalysis(data) {
      return data.analysis is map
        && data.analysis.danceId is string
        && data.analysis.educatorUid is string;
    }

    function linkedDanceExists(data) {
      return hasValidAnalysis(data)
        && exists(/databases/$(database)/documents/danceLibrary/$(data.analysis.danceId));
    }

    function linkedDanceOwner(data) {
      return get(/databases/$(database)/documents/danceLibrary/$(data.analysis.danceId)).data.educatorUid;
    }

    function validSessionWrite(data) {
      return linkedDanceExists(data)
        && linkedDanceOwner(data) == data.analysis.educatorUid;
    }

    // A practice session. Scores feed the server-computed leaderboard, so the
    // headline score must be a real 0..1 value. `analysis` (which dance and
    // creator it was) is optional; when present it must name a real dance.
    function isScore(v) {
      return v is number && v >= 0 && v <= 1;
    }

    function validSessionDoc(data, sessionId) {
      return data.keys().hasOnly(['sessionId', 'tsStart', 'tsEnd', 'activityName', 'activityType', 'durationMs',
          'smoothnessScore', 'balanceScore', 'timingConsistencyScore', 'alignmentScore', 'qualityFlag',
          'extraAnalytics', 'analysis', 'tzOffsetMinutes'])
        && data.sessionId == sessionId
        && isScore(data.alignmentScore)
        && isScore(data.get('timingConsistencyScore', 0))
        && isScore(data.get('smoothnessScore', 0))
        && isScore(data.get('balanceScore', 0))
        && data.get('durationMs', 0) is int
        && data.get('durationMs', 0) >= 0
        && (!('tzOffsetMinutes' in data)
          || (data.tzOffsetMinutes is int && data.tzOffsetMinutes >= -840 && data.tzOffsetMinutes <= 840))
        && isShortText(data.get('activityName', ''), 200)
        && isShortText(data.get('activityType', ''), 100)
        && isShortText(data.get('qualityFlag', ''), 100)
        && (!('extraAnalytics' in data) || data.extraAnalytics is map)
        && (!('analysis' in data) || validSessionWrite(data));
    }

    // The dance owner may clean up likes/comments when deleting their dance.
    function isDanceOwner(danceId) {
      return get(/databases/$(database)/documents/danceLibrary/$(danceId)).data.educatorUid == request.auth.uid;
    }

    // A dance is readable when it is public or the reader uploaded it. Read
    // visibility directly: a get('visibility', 'public') default lets list
    // queries through unchecked. Every dance has the field (set on upload,
    // by the danceDerivedFields function and by the backfill script).
    function canReadDance(dance) {
      return signedIn()
        && (dance.visibility == 'public'
          || dance.educatorUid == request.auth.uid);
    }

    function canReadDanceById(danceId) {
      return canReadDance(get(/databases/$(database)/documents/danceLibrary/$(danceId)).data);
    }

    // Fields a dance's creator writes, checked when they're set or changed.
    // Media must be the creator's own Storage files for this dance.
    function validDanceFields(d, changed, danceId) {
      let uid = request.auth.uid;
      return (!('title' in changed) || (d.title is string && d.title.size() <= 120))
        && (!('description' in changed) || isShortText(d.description, 2000))
        && (!('danceType' in changed) || isShortText(d.danceType, 40))
        && (!('educatorName' in changed) || isShortText(d.educatorName, 60))
        && (!('visibility' in changed) || d.visibility in ['public', 'private'])
        && (!('videoUrl' in changed) || isStorageUrl(d.videoUrl, 'danceVideos', uid))
        && (!('thumbnailUrl' in changed) || d.thumbnailUrl == '' || isStorageUrl(d.thumbnailUrl, 'danceThumbnails', uid))
        && (!('storagePath' in changed) || d.storagePath == 'danceVideos/' + uid + '/' + danceId + '.mp4')
        && (!('templateStoragePath' in changed) || d.templateStoragePath == ''
          || d.templateStoragePath == 'danceTemplates/' + uid + '/' + danceId + '.json');
    }

    // Kept up to date by Cloud Functions (functions/discovery.js); clients may
    // not set or change them.
    function serverManagedDanceFields() {
      return ['likeCount', 'trendingScore', 'feedReady', 'danceTypeKey', 'searchTokens', 'searchTrigrams', 'shuffleKey', 'linksRevokedAt'];
    }

    // A username on a profile must be claimed by that user in /usernames.
    function usernameClaimOk(uid) {
      return !('username' in request.resource.data)
        || (resource != null && resource.data.get('username', null) == request.resource.data.username)
        || (request.resource.data.username is string
          && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid);
    }

    // Changing username must release the old handle in the same write, so
    // nobody can hoard usernames.
    function oldUsernameReleased() {
      return resource == null
        || resource.data.get('username', null) == null
        || resource.data.username == request.resource.data.get('username', null)
        || !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.username));
    }

    function validProfileFields(data, changed) {
      return (!('uid' in changed) || data.uid == request.auth.uid)
        && (!('displayName' in changed) || isName(data.displayName))
        && (!('photoUrl' in changed) || isOptionalHttpsUrl(data.photoUrl))
        && (!('lastSeen' in changed) || data.lastSeen is int)
        // Roles are never granted from the client.
        && (!('role' in changed) || data.role == 'USER');
    }

    // Profiles: other users may read one profile at a time (name, photo,
    // username), never list them all. Email addresses are not stored here.
    match /users/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'photoUrl', 'role', 'lastSeen', 'username'])
        && validProfileFields(request.resource.data, request.resource.data.keys())
        && usernameClaimOk(uid);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'displayName', 'photoUrl', 'role', 'lastSeen', 'username', 'email'])
        // Email may only be removed (older app versions stored it).
        && !('email' in request.resource.data)
        && validProfileFields(request.resource.data, request.resource.data.diff(resource.data).affectedKeys())
        && usernameClaimOk(uid)
        && oldUsernameReleased();
      allow delete: if false;

      // Rewards are computed by Cloud Functions from synced practice
      // sessions (functions/rewards.js); the app can only read them.
      match /points/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Per-session reward summaries (points, badges, challenges) the app
      // shows after practice.
      match /sessionRewards/{sessionId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Push tokens of the user's devices (read by Cloud Functions).
      match /fcmTokens/{token} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && request.resource.data.token == token;
      }

      match /achievements/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Legacy path; nothing writes it any more.
      match /streak/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Weekly streak, kept by Cloud Functions from synced sessions.
      match /streaks/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Created and updated by Cloud Functions (weeklyChallenges callable,
      // rewardsFromSession).
      match /weeklyChallenges/{weekId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /friends/{friendUid} {
        allow read, write: if isOwner(uid);
      }

      match /danceLearningSessions/{sessionId} {
        allow read: if isOwner(uid) || (
          signedIn()
          && resource.data.analysis is map
          && resource.data.analysis.educatorUid is string
          && resource.data.analysis.educatorUid == request.auth.uid
        );

        allow create: if isOwner(uid)
          && validSessionDoc(request.resource.data, sessionId);

        // Sessions are final once uploaded: they drive points, badges and the
        // leaderboard (rewardsFromSession runs once, on create).
        allow update: if false;

        allow delete: if false;
      }
    }

    match /{path=**}/danceLearningSessions/{sessionId} {
      allow read: if signedIn()
        && resource.data.analysis is map
        && resource.data.analysis.educatorUid is string
        && resource.data.analysis.educatorUid == request.auth.uid;
    }

    match /danceLibrary/{danceId} {
      // Likes: one document per user, keyed by their uid.
      match /likes/{likerUid} {
        allow read: if canReadDanceById(danceId);
        // uid/createdAt let the liked-videos query find a user's likes.
        allow create, update: if signedIn()
          && request.auth.uid == likerUid
          && request.resource.data.keys().hasOnly(['liked', 'uid', 'createdAt'])
          && request.resource.data.liked == true
          && request.resource.data.get('uid', likerUid) == likerUid
          && request.resource.data.get('createdAt', 0) is int
          && canReadDanceById(danceId);
        allow delete: if signedIn()
          && (request.auth.uid == likerUid || isDanceOwner(danceId));
      }

      // Comments: authored by the caller, no edits, deletable by the author.
      match /comments/{commentId} {
        allow read: if canReadDanceById(danceId);
        allow create: if canReadDanceById(danceId)
          && request.resource.data.keys().hasOnly(['commentId', 'uid', 'username', 'text', 'createdAt'])
          && request.resource.data.commentId == commentId
          && request.resource.data.uid == request.auth.uid
          && isName(request.resource.data.username)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && isRecent(request.resource.data.createdAt, hourMs());
        allow update: if false;
        allow delete: if signedIn()
          && (resource.data.uid == request.auth.uid || isDanceOwner(danceId));
      }

      // Private dances are readable only by their uploader. List queries must
      // filter on visibility == "public" or on educatorUid == the reader.
      allow read: if canReadDance(resource.data);

      allow create: if signedIn()
        && request.resource.data.educatorUid == request.auth.uid
        && request.resource.data.danceId == danceId
        && !request.resource.data.keys().hasAny(serverManagedDanceFields())
        && isRecent(request.resource.data.createdAt, 24 * hourMs())
        && request.resource.data.get('enabled', true) == true
        && validDanceFields(request.resource.data, request.resource.data.keys(), danceId);

      // Upload time, creator name and media can't be changed afterwards, and
      // `enabled` is for moderation (set by an admin through the console).
      allow update: if signedIn()
        && resource.data.educatorUid == request.auth.uid
        && request.resource.data.educatorUid == resource.data.educatorUid
        && request.resource.data.danceId == resource.data.danceId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverManagedDanceFields())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt', 'educatorName', 'videoUrl', 'thumbnailUrl', 'enabled'])
        && validDanceFields(request.resource.data, request.resource.data.diff(resource.data).affectedKeys(), danceId);

      allow delete: if signedIn()
        && resource.data.educatorUid == request.auth.uid;
    }

    // Liked videos: a user's own like documents across all dances.
    match /{path=**}/likes/{likerUid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Written only by Cloud Functions (category chip counts).
    match /meta/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Computed by Cloud Functions from synced sessions and streaks
    // (functions/leaderboard.js); clients can't write their own rank.
    match /leaderboardStats/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ── Groups ────────────────────────────────────────────────────────────
    // Public groups (and their posts) are readable by anyone signed in;
    // private groups only by members. Members join public groups freely and
    // private groups with the group's invite code. Member counts and cleanup
    // after a group is deleted are handled by Cloud Functions.

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function isGroupMember(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function canReadGroup(groupId) {
      return signedIn()
        && (get(groupPath(groupId)).data.visibility == 'public' || isGroupMember(groupId));
    }

    function isGroupOwner(groupId) {
      return signedIn() && get(groupPath(groupId)).data.ownerUid == request.auth.uid;
    }

    function validGroupText(data) {
      return data.name is string
        && data.name.size() >= 3
        && data.name.size() <= 60
        && data.nameLower == data.name.lower()
        && data.description is string
        && data.description.size() <= 500;
    }

    // A post's attachment: none (text), one of the author's public dances, or
    // a group video the author uploaded for this post. Media URLs must be
    // files in this project's Storage, in the right owner's folder.
    function validPostAttachment(d, postId) {
      let uid = request.auth.uid;
      let noFiles = !d.keys().hasAny(['storagePath', 'thumbnailPath'])
        || (d.get('storagePath', null) == null && d.get('thumbnailPath', null) == null);
      return (d.kind == 'text' && d.body.size() > 0
          && !d.keys().hasAny(['danceId', 'videoUrl', 'thumbnailUrl']) && noFiles)
        || (d.kind == 'dance'
          && d.danceId is string
          && isShortText(d.get('danceTitle', ''), 120)
          && canReadDanceById(d.danceId)
          && get(/databases/$(database)/documents/danceLibrary/$(d.danceId)).data.educatorUid == uid
          && (d.get('videoUrl', null) == null || isStorageUrl(d.videoUrl, 'danceVideos', uid))
          && (d.get('thumbnailUrl', null) == null || isStorageUrl(d.thumbnailUrl, 'danceThumbnails', uid))
          && noFiles)
        || (d.kind == 'video'
          && isStorageUrl(d.videoUrl, 'groupVideos', uid)
          && d.storagePath == 'groupVideos/' + uid + '/' + postId + '.mp4'
          && (d.get('thumbnailUrl', null) == null || isStorageUrl(d.thumbnailUrl, 'groupThumbnails', uid))
          && (d.get('thumbnailPath', null) == null || d.thumbnailPath == 'groupThumbnails/' + uid + '/' + postId + '.jpg'));
    }

    match /groups/{groupId} {
      allow read: if signedIn()
        && (resource.data.visibility == 'public' || isGroupMember(groupId));

      // Created in one batch with the owner's membership (and, for private
      // groups, the invite document).
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['id', 'name', 'nameLower', 'description', 'visibility', 'ownerUid', 'ownerName', 'inviteCode', 'createdAt'])
        && request.resource.data.id == groupId
        && request.resource.data.ownerUid == request.auth.uid
        && isName(request.resource.data.ownerName)
        && isRecent(request.resource.data.createdAt, hourMs())
        && validGroupText(request.resource.data)
        && ((request.resource.data.visibility == 'public' && !request.resource.data.keys().hasAny(['inviteCode']))
          || (request.resource.data.visibility == 'private'
            && request.resource.data.inviteCode is string
            && request.resource.data.inviteCode.matches('[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{8}')
            // Its own invite document, created in the same batch.
            && getAfter(/databases/$(database)/documents/groupInvites/$(request.resource.data.inviteCode)).data.groupId == groupId))
        && existsAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'nameLower', 'description'])
        && validGroupText(request.resource.data);

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /members/{memberUid} {
        allow read: if canReadGroup(groupId);

        allow create: if signedIn()
          && memberUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'photoUrl', 'role', 'joinedAt', 'inviteCode'])
          && request.resource.data.uid == memberUid
          && isName(request.resource.data.displayName)
          && isOptionalHttpsUrl(request.resource.data.get('photoUrl', null))
          && isRecent(request.resource.data.joinedAt, hourMs())
          && (
            // Removed members can't come back (by code or invitation).
            request.resource.data.role == 'owner'
              || !exists(/databases/$(database)/documents/groups/$(groupId)/bans/$(memberUid))
          )
          && (
            // The creator, in the batch that creates the group.
            (request.resource.data.role == 'owner'
              && !exists(groupPath(groupId))
              && getAfter(groupPath(groupId)).data.ownerUid == request.auth.uid)
            ||
            // Anyone joining a public group, or a private one with its code
            // or an invitation sent to them.
            (request.resource.data.role == 'member'
              && exists(groupPath(groupId))
              && (get(groupPath(groupId)).data.visibility == 'public'
                || (request.resource.data.inviteCode is string
                  && request.resource.data.inviteCode == get(groupPath(groupId)).data.inviteCode)
                || exists(/databases/$(database)/documents/groupInvitations/$(groupId + '_' + memberUid))))
          );

        allow update: if false;

        // Members leave (the owner can't leave their own group); the owner
        // can remove members.
        allow delete: if signedIn()
          && ((memberUid == request.auth.uid && resource.data.role != 'owner')
            || (memberUid != request.auth.uid && isGroupOwner(groupId)));
      }

      // Users the owner removed; they can't rejoin. Written with the removal.
      match /bans/{bannedUid} {
        allow read: if isGroupOwner(groupId) || isOwner(bannedUid);
        allow create: if isGroupOwner(groupId)
          && bannedUid != request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'bannedAt'])
          && request.resource.data.uid == bannedUid
          && request.resource.data.bannedAt is int;
        allow update: if false;
        allow delete: if isGroupOwner(groupId);
      }

      match /posts/{postId} {
        allow read: if canReadGroup(groupId);

        allow create: if isGroupMember(groupId)
          && request.resource.data.keys().hasOnly(['id', 'uid', 'displayName', 'photoUrl', 'body', 'kind', 'danceId', 'danceTitle', 'videoUrl', 'thumbnailUrl', 'storagePath', 'thumbnailPath', 'createdAt'])
          && request.resource.data.id == postId
          && request.resource.data.uid == request.auth.uid
          && isName(request.resource.data.displayName)
          && isOptionalHttpsUrl(request.resource.data.get('photoUrl', null))
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 1500
          && isRecent(request.resource.data.createdAt, hourMs())
          && validPostAttachment(request.resource.data, postId);

        allow update: if false;

        allow delete: if signedIn()
          && (resource.data.uid == request.auth.uid || isGroupOwner(groupId));

        match /replies/{replyId} {
          allow read: if canReadGroup(groupId);

          allow create: if isGroupMember(groupId)
            && exists(/databases/$(database)/documents/groups/$(groupId)/posts/$(postId))
            && request.resource.data.keys().hasOnly(['id', 'postId', 'uid', 'displayName', 'photoUrl', 'body', 'createdAt'])
            && request.resource.data.id == replyId
            && request.resource.data.postId == postId
            && request.resource.data.uid == request.auth.uid
            && isName(request.resource.data.displayName)
            && isOptionalHttpsUrl(request.resource.data.get('photoUrl', null))
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 500
            && isRecent(request.resource.data.createdAt, hourMs());

          allow update: if false;

          allow delete: if signedIn()
            && (resource.data.uid == request.auth.uid || isGroupOwner(groupId));
        }
      }
    }

    // Unique usernames: the document ID is the handle. Claimed in the same
    // batch that sets users/{uid}.username; the old handle is released in the
    // batch that changes it. A create on a taken handle is an update, so it fails.
    match /usernames/{handle} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 20;
      allow create: if signedIn()
        && handle.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is int
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('username', null) == handle;
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('username', null) != handle;
    }

    // Invitations to a group for one user, sent by a member. The ID is
    // <groupId>_<inviteeUid>. The invitee accepts by joining (see members) and
    // deleting it, or declines by deleting it.
    match /groupInvitations/{invitationId} {
      allow read: if signedIn()
        && (resource.data.inviteeUid == request.auth.uid || resource.data.inviterUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['groupId', 'groupName', 'inviteeUid', 'inviteeUsername', 'inviterUid', 'inviterName', 'createdAt'])
        && request.resource.data.groupId is string
        && request.resource.data.inviteeUid is string
        && invitationId == request.resource.data.groupId + '_' + request.resource.data.inviteeUid
        && request.resource.data.inviterUid == request.auth.uid
        && request.resource.data.inviteeUid != request.auth.uid
        && isName(request.resource.data.inviterName)
        && isShortText(request.resource.data.get('inviteeUsername', ''), 20)
        && isRecent(request.resource.data.createdAt, hourMs())
        && isGroupMember(request.resource.data.groupId)
        && !exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId)/bans/$(request.resource.data.inviteeUid))
        && request.resource.data.groupName == get(groupPath(request.resource.data.groupId)).data.name
        && !exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId)/members/$(request.resource.data.inviteeUid))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.inviteeUid));
      allow update: if false;
      allow delete: if signedIn()
        && (resource.data.inviteeUid == request.auth.uid
          || resource.data.inviterUid == request.auth.uid
          || isGroupOwner(resource.data.groupId));
    }

    // Invite code -> group, so a code can open a private group the user can't
    // read yet. Only single lookups by code are allowed (no listing).
    match /groupInvites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['groupId', 'createdAt'])
        && getAfter(groupPath(request.resource.data.groupId)).data.ownerUid == request.auth.uid
        && getAfter(groupPath(request.resource.data.groupId)).data.inviteCode == code;
      allow update: if false;
      allow delete: if false;
    }

    // "My groups": a user's own memberships across all groups.
    match /{path=**}/members/{memberUid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Legacy forum (replaced by groups). Data is kept; the app no longer shows it.
    match /communityPosts/{postId} {
      allow read: if signedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;

      match /replies/{replyId} {
        allow read: if signedIn();
        allow create: if false;
        allow update: if false;
        allow delete: if signedIn()
          && resource.data.uid == request.auth.uid;
      }
    }
  }
}

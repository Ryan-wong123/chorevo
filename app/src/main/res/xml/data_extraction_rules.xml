<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup and device transfer. Only reminder/theme preferences are
    backed up: never the sign-in session (shared_prefs), the local database of
    practice sessions, the Firestore cache or cached videos.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/notification_preferences.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/notification_preferences.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
